# Projet FraisZen : image des agents d'exécution (voir projects/README.md).
AOS_PROJECT_SLUG=fraiszen
AOS_PROJECT_REPOSITORY=zeggriim2/fraisZen
AOS_PROJECT_BASE=develop
# Fichiers dont le contenu détermine les caches de dépendances de l'image.
AOS_PROJECT_LOCKS="composer.lock frontend/package-lock.json"
# Vérification hors ligne lancée par `task project:image:verify` (et commande de test du projet).
AOS_PROJECT_VERIFY="aos-setup && aos-ci all && aos-qa-browser --self-test /opt/aos/scratch/qa-selftest"
# Ressources des conteneurs d'agents (profils aos-fraiszen-*).
AOS_PROJECT_CPU=2
AOS_PROJECT_MEMORY_MB=6144
AOS_PROJECT_COMMAND_TIMEOUT=600
